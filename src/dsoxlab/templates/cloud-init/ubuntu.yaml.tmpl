#cloud-config
# Cloud-init Ubuntu 24.04 LTS — VMs lab dsoxlab.
# Variables Terraform substituées via templatefile() : hostname, ssh_pubkey.

hostname: ${hostname}
fqdn: ${hostname}.lab
manage_etc_hosts: true
preserve_hostname: false

users:
  - name: student
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    # lock_passwd: false + passwd: '*' : sshd 9+ (Ubuntu 24.04 avec
    # OpenSSH 9.6, AlmaLinux 10) rejette les comptes ``locked`` (hash
    # préfixé par ``!``) même en authentification par clé publique.
    # Cloud-init applique ``lock_passwd: true`` par défaut → préfixe
    # ``!`` devant tout passwd. On force explicitement ``false``.
    lock_passwd: false
    passwd: "*"
    ssh_authorized_keys:
      - ${ssh_pubkey}

  # ansible : compte de SERVICE d'automatisation, distinct du compte humain
  # ``student``. C'est lui que dsoxlab et les playbooks des labs utilisent pour
  # se connecter (ansible_user: ansible). Même durcissement : clé SSH uniquement,
  # sans mot de passe. NOPASSWD:ALL volontaire (automatisation généraliste).
  - name: ansible
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: false
    passwd: "*"
    ssh_authorized_keys:
      - ${ssh_pubkey}

disable_root: true
ssh_pwauth: false

# Miroir des paquets : le premier qui répond, essayé DEPUIS LA VM.
#
# archive.ubuntu.com et security.ubuntu.com sont tous deux servis par
# Canonical, et tombent ensemble. Mesuré le 2026-11-19 : le ping passait,
# HTTP et HTTPS ne répondaient plus, deux fois dans la journée. cloud-init
# n'installait alors aucun paquet, et tout setup.yaml qui passe par apt
# échouait ensuite sur une machine pourtant « prête ».
#
# Le choix se fait dans la VM et pas sur l'hôte : c'est sa route qui compte,
# et un provider cloud ne passe pas par le réseau de l'hôte. Les miroirs de
# secours sont des miroirs nationaux officiels hébergés HORS de Canonical
# (gb et us, eux, pointent sur les mêmes serveurs et tombent avec eux), et
# ils portent la poche -security. La sonde lit justement le Release de
# -security : un miroir qui l'a sert aussi les autres poches.
#
# bootcmd passe AVANT apt_configure, qui régénère ubuntu.sources :
# preserve_sources_list garde la réécriture. Si aucun miroir ne répond, rien
# n'est touché et rien n'est noté : le démarrage suivant réessaie. Le script
# sort en 0 dans tous les cas, pour ne jamais faire échouer le démarrage. Le
# miroir retenu est noté dans /var/lib/dsoxlab/miroir-apt, pour le
# diagnostic, et le choix n'est plus refait ensuite.
apt:
  preserve_sources_list: true

bootcmd:
  - |
    test -e /var/lib/dsoxlab/miroir-apt && exit 0
    mkdir -p /var/lib/dsoxlab
    suite=$(. /etc/os-release && echo "$VERSION_CODENAME")-security
    for m in http://archive.ubuntu.com/ubuntu http://fr.archive.ubuntu.com/ubuntu http://de.archive.ubuntu.com/ubuntu http://nl.archive.ubuntu.com/ubuntu http://ch.archive.ubuntu.com/ubuntu; do
      if curl -fsS -m 10 -o /dev/null "$m/dists/$suite/Release"; then
        if [ "$m" != http://archive.ubuntu.com/ubuntu ]; then
          for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
            [ -f "$f" ] && sed -i -E "s#https?://(archive|security)\.ubuntu\.com/ubuntu/?#$m#g" "$f"
          done
        fi
        echo "$m" > /var/lib/dsoxlab/miroir-apt
        exit 0
      fi
    done
    exit 0

# Outils minimum pour les labs LFCS Debian-like — diagnostic.
package_update: true
packages:
  # openssh-server : NON préinstallé sur les images Incus cloud (Incus
  # passe par incus exec via l'agent). On l'installe pour avoir un
  # flow SSH unifié avec les autres providers (kvm, outscale). Sur
  # les images cloud Ubuntu pour KVM/Outscale il est déjà présent —
  # cette ligne est idempotente.
  - openssh-server
  - vim
  - tmux
  - bash-completion
  - tree
  - lsof
  - strace
  - tcpdump
  # bind9-dnsutils et non dnsutils : ce dernier n'était qu'un paquet de
  # transition, retiré de Debian 13 et d'Ubuntu 26. Il n'y a plus de
  # candidat, donc cloud-init sort en « status: error » à chaque
  # provisionnement, et dig comme nslookup manquent. bind9-dnsutils
  # existe depuis Debian 11 et Ubuntu 21.04 : il couvre donc aussi les
  # distributions plus anciennes du contrat.
  - bind9-dnsutils
  - net-tools
  - ufw
  - apparmor
  - apparmor-utils
  # qemu-guest-agent : laisse libvirt récupérer l'IP via virtio channel
  # (``virsh domifaddr --source agent``) côté provider kvm.
  - qemu-guest-agent

runcmd:
  # Garde-fou anti-locking : force le hash à '*' (cf. commentaire dans
  # la section users). Idempotent.
  - [ usermod, -p, "*", student ]
  - [ usermod, -p, "*", ansible ]
  - [ systemctl, enable, --now, ssh ]
  # `enable` SANS `--now` : l'unité déclare
  # `BindsTo=dev-virtio\x2dports-org.qemu.guest_agent.0.device`, or le
  # provider KVM ne déclare aucun channel virtio (cf. la note dans
  # templates/terraform/kvm/main.tf). Le device n'existe donc jamais, et
  # `--now` attendait 90 s avant d'échouer : le script runcmd sortait en 1,
  # cloud-init finissait en `status: error`, et `dsoxlab provision` restait
  # bloqué sur son attente alors que la VM était prête.
  # L'activation est conservée : le jour où un channel est déclaré (ou sur
  # un provider qui en fournit un), le service démarrera au boot.
  - [ systemctl, enable, qemu-guest-agent ]

# Sécurité par défaut : AppArmor reste activé. UFW est installé mais
# pas activé par défaut — c'est aux labs LFCS de l'activer
# explicitement (pour ne pas couper la SSH du provisioning).
